---
import WorkList from "../../../components/WorkList.astro";
import Layout from "../../../layouts/Layout.astro";
import { projectsPageCopy } from "../../../data/copy";
import { works } from "../../../data/works";

const copy = projectsPageCopy.zh;
---

<Layout title={copy.title} description={copy.description} lang="zh" pathname="/zh/projects/">
  <section class="page-hero">
    <p class="eyebrow">{copy.hero.eyebrow}</p>
    <h1>{copy.hero.title}</h1>
    <p>{copy.hero.body}</p>
  </section>
  <section class="section section--compact">
    <WorkList lang="zh" works={works} />
  </section>
</Layout>
