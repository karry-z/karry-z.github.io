---
import CTAButton from "../../../components/CTAButton.astro";
import PDFPreview from "../../../components/PDFPreview.astro";
import Layout from "../../../layouts/Layout.astro";
import { profile } from "../../../data/profile";

const title = "CV | Kairui Zhang 张恺睿";
const description = "Kairui Zhang（张恺睿）的英文 CV 页面。";
---

<Layout title={title} description={description} lang="zh" pathname="/zh/cv/">
  <section class="page-hero">
    <p class="eyebrow">CV</p>
    <h1>CV</h1>
    <p>这里只保留英文 CV PDF。</p>
    <div class="button-row">
      <CTAButton href={profile.cv.en} label="下载英文 CV PDF" variant="primary" download />
    </div>
  </section>
  <PDFPreview src={profile.cv.en} title="下载英文 CV" fallback="如果浏览器不能显示 PDF，请使用下载链接。" />
</Layout>
