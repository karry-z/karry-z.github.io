---
import Hero from "../../components/Hero.astro";
import NewsList from "../../components/NewsList.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import Layout from "../../layouts/Layout.astro";
import { news } from "../../data/news";
import { profile } from "../../data/profile";
import { projects } from "../../data/projects";

const title = "Kairui Zhang 张恺睿 | audio-visual-language learning · interactive AI · Mechanistic Interpretability";
const description =
  "Kairui Zhang（张恺睿）是英国布里斯托大学博士生，研究 audio-visual-language learning、interactive AI、Mechanistic Interpretability、benchmark 设计、受控 VLM 评估和表示层分析。";
---

<Layout title={title} description={description} lang="zh" pathname="/zh/">
  <Hero lang="zh" />

  <section class="section section-band" id="featured-projects">
    <div class="section-heading">
      <p class="eyebrow">当前工作</p>
      <h2>代表性项目</h2>
    </div>
    <ProjectGrid lang="zh" projects={projects} />
  </section>

  <section class="section" id="news" aria-labelledby="news-heading">
    <div>
      <div class="section-heading">
        <p class="eyebrow">动态</p>
        <h2 id="news-heading">近期更新</h2>
      </div>
      <NewsList lang="zh" items={news} />
    </div>
  </section>

  <section class="section section-band" id="benchmark-discussion">
    <div class="discussion">
      <div>
        <p class="eyebrow">Benchmark 相关讨论</p>
        <h2>聚焦的 benchmark 设计问题</h2>
      </div>
      <div>
        <p>
          目前我更希望讨论聚焦的 benchmark 设计问题，尤其是能把行为层面的失败模式和表示层面的证据联系起来的多模态评估设置。
        </p>
        <div class="button-row">
          <a class="button button--primary" href={`mailto:${profile.email}`}>Email</a>
          <a class="button" href={profile.links.googleScholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>
          <a class="button" href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
