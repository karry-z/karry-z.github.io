---
import Hero from "../components/Hero.astro";
import NewsList from "../components/NewsList.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import Layout from "../layouts/Layout.astro";
import { homePageCopy } from "../data/copy";
import { news } from "../data/news";
import { profile } from "../data/profile";
import { projects } from "../data/projects";

const copy = homePageCopy.en;
---

<Layout title={copy.title} description={copy.description} lang="en" pathname="/">
  <Hero lang="en" />

  <section class="section section-band" id="featured-projects">
    <div class="section-heading">
      <p class="eyebrow">{copy.featured.eyebrow}</p>
      <h2>{copy.featured.title}</h2>
    </div>
    <ProjectGrid lang="en" projects={projects} />
  </section>

  <section class="section" id="news" aria-labelledby="news-heading">
    <div>
      <div class="section-heading">
        <p class="eyebrow">{copy.news.eyebrow}</p>
        <h2 id="news-heading">{copy.news.title}</h2>
      </div>
      <NewsList lang="en" items={news} />
    </div>
  </section>

  <section class="section section-band" id="benchmark-discussion">
    <div class="discussion">
      <div>
        <p class="eyebrow">{copy.benchmarkDiscussion.eyebrow}</p>
        <h2>{copy.benchmarkDiscussion.title}</h2>
      </div>
      <div>
        <p>
          {copy.benchmarkDiscussion.body}
        </p>
        <div class="button-row">
          <a class="button button--primary" href={`mailto:${profile.email}`}>{copy.benchmarkDiscussion.links.email}</a>
          <a class="button" href={profile.links.googleScholar} target="_blank" rel="noopener noreferrer">{copy.benchmarkDiscussion.links.googleScholar}</a>
          <a class="button" href={profile.links.github} target="_blank" rel="noopener noreferrer">{copy.benchmarkDiscussion.links.github}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
