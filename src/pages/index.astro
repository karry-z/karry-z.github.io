---
import Hero from "../components/Hero.astro";
import NewsList from "../components/NewsList.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import Layout from "../layouts/Layout.astro";
import { news } from "../data/news";
import { profile } from "../data/profile";
import { projects } from "../data/projects";

const title = "Kairui Zhang | audio-visual-language learning · interactive AI · Mechanistic Interpretability";
const description =
  "Kairui Zhang is a PhD student at the University of Bristol working on audio-visual-language learning, interactive AI, mechanistic interpretability, benchmark design, controlled VLM evaluation, and representation-level analysis.";
---

<Layout title={title} description={description} lang="en" pathname="/">
  <Hero lang="en" />

  <section class="section section-band" id="featured-projects">
    <div class="section-heading">
      <p class="eyebrow">Current work</p>
      <h2>Featured projects</h2>
    </div>
    <ProjectGrid lang="en" projects={projects} />
  </section>

  <section class="section" id="news" aria-labelledby="news-heading">
    <div>
      <div class="section-heading">
        <p class="eyebrow">News</p>
        <h2 id="news-heading">Recent updates</h2>
      </div>
      <NewsList lang="en" items={news} />
    </div>
  </section>

  <section class="section section-band" id="benchmark-discussion">
    <div class="discussion">
      <div>
        <p class="eyebrow">Benchmark-focused discussions</p>
        <h2>Focused benchmark ideas</h2>
      </div>
      <div>
        <p>
          I am happy to discuss focused benchmark ideas for multimodal mechanistic interpretability, especially settings that connect behavior-level failures with representation-level evidence.
        </p>
        <div class="button-row">
          <a class="button button--primary" href={`mailto:${profile.email}`}>Email</a>
          <a class="button" href={profile.links.googleScholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>
          <a class="button" href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
