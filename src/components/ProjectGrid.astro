---
import ProjectCard from "./ProjectCard.astro";
import type { Lang } from "../data/nav";
import type { Project } from "../data/projects";
import { categoryCopy, projectListCopy } from "../data/copy";

type Props = {
  lang: Lang;
  projects: Project[];
  filters?: boolean;
};

const { lang, projects, filters = false } = Astro.props;
const categoryLabels = categoryCopy[lang];
const copy = projectListCopy[lang];
const filterLabels = [
  ["all", categoryLabels.all],
  ["benchmark", categoryLabels.benchmark],
  ["evaluation", categoryLabels.evaluation],
  ["interpretability", categoryLabels.interpretability]
];
---

<div class="project-grid-wrap" data-project-grid>
  {filters && (
    <div class="filter-bar" aria-label={copy.filtersLabel}>
      {filterLabels.map(([value, label], index) => (
        <button type="button" class:list={["filter-button", index === 0 && "is-active"]} data-project-filter={value} aria-pressed={index === 0 ? "true" : "false"}>
          {label}
        </button>
      ))}
    </div>
  )}
  <div class="project-grid">
    {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
  </div>
</div>

<script is:inline>
  document.querySelectorAll("[data-project-grid]").forEach((grid) => {
    const buttons = Array.from(grid.querySelectorAll("[data-project-filter]"));
    const cards = Array.from(grid.querySelectorAll("[data-project-card]"));
    if (!buttons.length) return;

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.getAttribute("data-project-filter");
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });
        cards.forEach((card) => {
          const show = filter === "all" || card.getAttribute("data-category") === filter;
          card.hidden = !show;
        });
      });
    });
  });
</script>
