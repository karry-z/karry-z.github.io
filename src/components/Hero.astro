---
import CTAButton from "./CTAButton.astro";
import { profile } from "../data/profile";
import type { Lang } from "../data/nav";
import { heroCopy } from "../data/copy";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const copy = heroCopy[lang];
---

<section class="hero">
  <div class="hero__content">
    <div class="hero__copy">
      <h1>{copy.displayName}</h1>
      <p class="hero__research">{copy.research}</p>
      <p class="hero__lead">{copy.position} {copy.body}</p>
      <p>
        {copy.labPrefix}{" "}
        <a href={profile.links.intelligentSystemsLab} target="_blank" rel="noopener noreferrer">Intelligent Systems Laboratory</a>
        {" "}
        {copy.labSuffix}{" "}
        <a href={profile.links.zahraa} target="_blank" rel="noopener noreferrer">Zahraa S. Abdallah</a>
        {copy.supervisorJoiner}
        <a href={profile.links.martha} target="_blank" rel="noopener noreferrer">Martha Lewis</a>
        {copy.supervisorEnd}
      </p>
      <div class="button-row">
        <CTAButton href="#featured-projects" label={copy.ctas.featuredProjects} variant="primary" />
        <CTAButton href="#news" label={copy.ctas.news} />
        <CTAButton href="#benchmark-discussion" label={copy.ctas.benchmarkDiscussion} />
        <CTAButton href={profile.cv.en} label={copy.ctas.cv} download />
      </div>
    </div>
    <figure class="hero__portrait">
      <img src={profile.image} alt={copy.portraitAlt} loading="eager" />
    </figure>
  </div>
</section>
