---
import type { Lang } from "../data/nav";
import type { WorkItem } from "../data/works";

type Props = {
  lang: Lang;
  works: WorkItem[];
};

const { lang, works } = Astro.props;
const copy = {
  en: {
    search: "Search projects",
    searchLabel: "Search projects by title, author, keyword, or venue",
    filters: "Project filters",
    all: "All",
    benchmark: "Benchmark",
    evaluation: "Evaluation",
    interpretability: "Interpretability",
    control: "Control",
    sort: "Sort",
    newest: "Newest first",
    oldest: "Oldest first",
    title: "Title A-Z",
    noResults: "No matching projects."
  },
  zh: {
    search: "搜索项目",
    searchLabel: "按标题、作者、关键词或 venue 搜索项目",
    filters: "项目筛选",
    all: "全部",
    benchmark: "Benchmark",
    evaluation: "评估",
    interpretability: "可解释性",
    control: "控制",
    sort: "排序",
    newest: "年份从新到旧",
    oldest: "年份从旧到新",
    title: "标题 A-Z",
    noResults: "没有匹配的项目。"
  }
}[lang];

const filterLabels = [
  ["all", copy.all],
  ["benchmark", copy.benchmark],
  ["evaluation", copy.evaluation],
  ["interpretability", copy.interpretability],
  ["control", copy.control]
];
---

<div class="work-list-wrap" data-work-list>
  <div class="work-controls" aria-label={copy.filters}>
    <label class="work-search">
      <span>{copy.searchLabel}</span>
      <input type="search" placeholder={copy.search} data-work-search />
    </label>

    <div class="filter-bar" role="group" aria-label={copy.filters}>
      {filterLabels.map(([value, label], index) => (
        <button type="button" class:list={["filter-button", index === 0 && "is-active"]} data-work-filter={value} aria-pressed={index === 0 ? "true" : "false"}>
          {label}
        </button>
      ))}
    </div>

    <label class="work-sort">
      <span>{copy.sort}</span>
      <select data-work-sort>
        <option value="newest">{copy.newest}</option>
        <option value="oldest">{copy.oldest}</option>
        <option value="title">{copy.title}</option>
      </select>
    </label>
  </div>

  <div class="work-list" data-work-items>
    {works.map((work) => {
      const searchText = [
        work.title,
        work.authors,
        work.venue,
        work.publicationType,
        work.status,
        work.question.en,
        work.question.zh,
        work.summary.en,
        work.summary.zh,
        ...work.chips.en,
        ...work.chips.zh
      ].join(" ");

      return (
        <article
          class="work-item"
          data-work-item
          data-category={work.category}
          data-year={work.year}
          data-title={work.title.toLocaleLowerCase()}
          data-search={searchText.toLocaleLowerCase()}
        >
          <div class="work-item__media">
            {work.primaryHref ? (
              <a href={work.primaryHref} target="_blank" rel="noopener noreferrer" aria-label={`${work.primaryLabel}: ${work.title}`}>
                <img src={work.thumbnail} alt={work.alt} loading="lazy" />
              </a>
            ) : (
              <img src={work.thumbnail} alt={work.alt} loading="lazy" />
            )}
          </div>

          <div class="work-item__content">
            <p class="publication-meta">{work.year} · {work.venue} · {work.publicationType}</p>
            <h2>{work.title}</h2>
            <p class="publication-authors">{work.authors}</p>
            <p class="project-question">{work.question[lang]}</p>
            <p>{work.summary[lang]}</p>
            {work.caveat && <p class="claim-note">{work.caveat[lang]}</p>}
            <div class="chip-row work-item__tags" aria-label={lang === "en" ? "Project tags" : "项目标签"}>
              {work.chips[lang].map((chip) => <span class="chip">{chip}</span>)}
            </div>
            {work.publicationLinks.length > 0 && (
              <div class="text-link-row">
                {work.publicationLinks.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                ))}
              </div>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <p class="work-list__empty" data-work-empty hidden>{copy.noResults}</p>
</div>

<script is:inline>
  document.querySelectorAll("[data-work-list]").forEach((wrap) => {
    const search = wrap.querySelector("[data-work-search]");
    const sort = wrap.querySelector("[data-work-sort]");
    const buttons = Array.from(wrap.querySelectorAll("[data-work-filter]"));
    const list = wrap.querySelector("[data-work-items]");
    const empty = wrap.querySelector("[data-work-empty]");
    const items = Array.from(wrap.querySelectorAll("[data-work-item]"));
    let activeFilter = "all";

    function applyState() {
      const query = (search?.value || "").trim().toLowerCase();
      const sortMode = sort?.value || "newest";
      const ordered = [...items].sort((a, b) => {
        if (sortMode === "oldest") return Number(a.dataset.year) - Number(b.dataset.year);
        if (sortMode === "title") return (a.dataset.title || "").localeCompare(b.dataset.title || "");
        return Number(b.dataset.year) - Number(a.dataset.year);
      });

      ordered.forEach((item) => list?.append(item));

      let visibleCount = 0;
      items.forEach((item) => {
        const categoryMatch = activeFilter === "all" || item.dataset.category === activeFilter;
        const searchMatch = !query || (item.dataset.search || "").includes(query);
        const visible = categoryMatch && searchMatch;
        item.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (empty) empty.hidden = visibleCount !== 0;
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        activeFilter = button.getAttribute("data-work-filter") || "all";
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });
        applyState();
      });
    });

    search?.addEventListener("input", applyState);
    search?.addEventListener("search", applyState);
    search?.addEventListener("change", applyState);
    sort?.addEventListener("change", applyState);
    applyState();
  });
</script>
