---
import { footerLinks, profile } from "../data/profile";
import type { Lang } from "../data/nav";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>&copy; {year} {profile.name}</p>
    <nav aria-label={lang === "en" ? "Footer links" : "页脚链接"}>
      {footerLinks.map((link) => (
        <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
