---
import { profile } from "../data/profile";
import { localizedPath, type Lang } from "../data/nav";

type Props = {
  title: string;
  description: string;
  lang: Lang;
  pathname: string;
};

const { title, description, lang, pathname } = Astro.props;
const canonical = new URL(pathname, profile.links.homepage).toString();
const alternateLang = lang === "en" ? "zh" : "en";
const alternatePath = localizedPath(pathname, alternateLang);
const alternateUrl = new URL(alternatePath, profile.links.homepage).toString();
const ogImage = new URL(profile.image, profile.links.homepage).toString();
const keywords = [
  "Kairui Zhang",
  "张恺睿",
  "multimodal mechanistic interpretability",
  "audio-visual-language modeling",
  "vision-language evaluation",
  "sparse autoencoders",
  "SAE",
  "University of Bristol",
  "benchmark design"
].join(", ");

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.chineseName,
  jobTitle: profile.title,
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: profile.institution
  },
  email: profile.email,
  url: profile.links.homepage,
  sameAs: [
    profile.links.googleScholar,
    profile.links.github,
    profile.links.orcid,
    profile.links.bristolProfile,
    profile.links.homepage
  ],
  knowsAbout: [
    "audio-visual-language learning",
    "interactive AI",
    "Mechanistic Interpretability",
    "audio-visual-language modeling",
    "vision-language evaluation",
    "sparse autoencoders",
    "benchmark design"
  ]
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="robots" content="index,follow" />
<title>{title}</title>
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang={lang} href={canonical} />
<link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
<link rel="alternate" hreflang="x-default" href={new URL("/", profile.links.homepage).toString()} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
