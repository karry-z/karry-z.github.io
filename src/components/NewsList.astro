---
import type { Lang } from "../data/nav";
import type { NewsItem } from "../data/news";

type Props = {
  lang: Lang;
  items: NewsItem[];
};

const { lang, items } = Astro.props;
---

<ul class="news-list">
  {items.slice(0, 3).map((item) => (
    <li>
      <time>{item.date[lang]}</time>
      <a href={item.href} target="_blank" rel="noopener noreferrer">{item.text[lang]}</a>
    </li>
  ))}
</ul>
