---
import { localizedPath, nav, type Lang } from "../data/nav";

type Props = {
  lang: Lang;
  currentPath: string;
};

const { lang, currentPath } = Astro.props;
const switchLang: Lang = lang === "en" ? "zh" : "en";
const switchHref = localizedPath(currentPath, switchLang);
const switchLabel = lang === "en" ? "中文" : "EN";
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-mark" href={lang === "en" ? "/" : "/zh/"} aria-label="Kairui Zhang home">
      <span>Kairui Zhang</span>
    </a>
    <nav class="site-nav" aria-label={lang === "en" ? "Main navigation" : "主导航"}>
      {nav[lang].map((item) => (
        <a class:list={["nav-link", currentPath === item.href && "is-active"]} href={item.href}>
          {item.label}
        </a>
      ))}
      <a class="nav-link nav-link--language" href={switchHref}>{switchLabel}</a>
    </nav>
  </div>
</header>
