---
import type { Locale } from "../../i18n";
import "../../styles/global.css";
import DocumentHead from "./DocumentHead.astro";
import { getSiteConfig, type PageKey } from "./siteConfig";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

type Props = {
  title: string;
  description: string;
  locale: Locale;
  pageKey?: PageKey;
  pathname: string;
};

const { title, description, locale, pageKey, pathname } = Astro.props;
const siteConfig = getSiteConfig(locale);
const alternatePath = pageKey ? siteConfig.header.languageSwitch.hrefs[pageKey] : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <DocumentHead
      title={title}
      description={description}
      locale={locale}
      pathname={pathname}
      alternatePath={alternatePath}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{siteConfig.skipLinkLabel}</a>
    <SiteHeader header={siteConfig.header} currentPage={pageKey} />
    <main id="main" class:list={["site-main", pageKey === "home" && "site-main--home"]}>
      <slot />
    </main>
    <SiteFooter footer={siteConfig.footer} isHome={pageKey === "home"} />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 80;
    transform: translateY(-160%);
    border-radius: 8px;
    background: var(--text, #111827);
    color: #ffffff;
    padding: 0.55rem 0.8rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-main {
    padding-top: var(--site-header-height, 72px);
  }

  .site-main--home {
    padding-top: 0;
  }
</style>
