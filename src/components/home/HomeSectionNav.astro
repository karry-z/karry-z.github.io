---
import type { HomeConfig, HomeSectionKey } from "./homeConfig";

type Props = {
  homeConfig: HomeConfig;
};

const { homeConfig } = Astro.props;
const items = homeConfig.sectionOrder.map((sectionKey: HomeSectionKey) => ({
  key: sectionKey,
  id: homeConfig.sectionIds[sectionKey],
  label: homeConfig.sectionLabels[sectionKey]
}));
---

<nav class="home-section-nav" aria-label={homeConfig.sectionNavAriaLabel} data-home-section-nav>
  {items.map((item, index) => (
    <a
      class:list={["home-section-nav__link", index === 0 && "is-active"]}
      href={`#${item.id}`}
      data-home-section-link={item.id}
      aria-label={item.label}
      aria-current={index === 0 ? "location" : undefined}
    >
      <span class="home-section-nav__label">{item.label}</span>
      <span class="home-section-nav__line" aria-hidden="true"></span>
    </a>
  ))}
</nav>

<script is:inline>
  (() => {
    const links = Array.from(document.querySelectorAll("[data-home-section-link]"));
    if (!links.length) return;

    const sections = links
      .map((link) => {
        const id = link.getAttribute("data-home-section-link");
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean);

    if (!sections.length) return;

    function setActiveSection(id) {
      links.forEach((link) => {
        const active = link.getAttribute("data-home-section-link") === id;
        link.classList.toggle("is-active", active);
        if (active) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    }

    const hashId = window.location.hash.slice(1);
    if (hashId && sections.some((section) => section.id === hashId)) {
      setActiveSection(hashId);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visible?.target?.id) {
          setActiveSection(visible.target.id);
        }
      },
      {
        root: null,
        rootMargin: "-20% 0px -45% 0px",
        threshold: [0.35, 0.5, 0.65, 0.8]
      }
    );

    sections.forEach((section) => observer.observe(section));
  })();
</script>

<style>
  .home-section-nav {
    position: fixed;
    left: 50%;
    bottom: 1.35rem;
    z-index: 40;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.72rem;
    transform: translateX(-50%);
  }

  .home-section-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 1.6rem;
    text-decoration: none;
  }

  .home-section-nav__line {
    width: 1.9rem;
    height: 3px;
    border-radius: 999px;
    background: rgba(166, 132, 38, 0.42);
    transition:
      width 140ms ease,
      height 140ms ease,
      background-color 140ms ease,
      transform 140ms ease;
  }

  .home-section-nav__label {
    position: absolute;
    bottom: 1.55rem;
    left: 50%;
    transform: translateX(-50%) translateY(0.25rem);
    min-width: max-content;
    color: #7a5b12;
    font-size: 0.78rem;
    font-weight: 700;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  .home-section-nav__link:hover .home-section-nav__line,
  .home-section-nav__link:focus-visible .home-section-nav__line,
  .home-section-nav__link.is-active .home-section-nav__line {
    width: 2.7rem;
    height: 4px;
    background: rgba(177, 122, 24, 0.82);
    transform: translateY(-1px);
  }

  .home-section-nav__link:hover .home-section-nav__label,
  .home-section-nav__link:focus-visible .home-section-nav__label,
  .home-section-nav__link.is-active .home-section-nav__label {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 720px) {
    .home-section-nav {
      display: none;
    }
  }
</style>
