---
import type { Project } from "../../content";

type Props = {
  title: string;
  projects: Project[];
};

const { title, projects } = Astro.props;
---

<div class="selected-projects">
  <div class="selected-projects__heading">
    <h2>{title}</h2>
  </div>

  <div class="selected-projects__grid">
    {projects.map((project) => (
      <article class="selected-projects__card">
        {project.projectPageLink ? (
          <a class="selected-projects__media" href={project.projectPageLink} target="_blank" rel="noopener noreferrer" aria-label={project.title}>
            <img src={project.imagePath} alt={project.title} loading="lazy" />
          </a>
        ) : (
          <div class="selected-projects__media">
            <img src={project.imagePath} alt={project.title} loading="lazy" />
          </div>
        )}
        <div class="selected-projects__body">
          <p class="selected-projects__meta">{project.date}{project.venue ? ` · ${project.venue}` : ""}</p>
          <h3>
            {project.projectPageLink ? (
              <a href={project.projectPageLink} target="_blank" rel="noopener noreferrer">{project.title}</a>
            ) : (
              project.title
            )}
          </h3>
          <p>{project.description}</p>
          <div class="selected-projects__keywords">
            {project.keywords.map((keyword) => <span>{keyword}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .selected-projects__heading {
    margin-bottom: 1.25rem;
  }

  .selected-projects__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .selected-projects__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line, #e5e7eb);
    border-radius: 8px;
    background: #ffffff;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .selected-projects__card:hover,
  .selected-projects__card:focus-within {
    border-color: rgba(37, 99, 235, 0.45);
    box-shadow: var(--shadow-card, 0 10px 30px rgba(15, 23, 42, 0.06));
    transform: translateY(-2px);
  }

  .selected-projects__media {
    display: block;
    background: var(--bg-soft, #f8fafc);
    overflow: hidden;
  }

  .selected-projects__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    object-position: center;
    transition: transform 180ms ease;
  }

  .selected-projects__card:hover .selected-projects__media img,
  .selected-projects__card:focus-within .selected-projects__media img {
    transform: scale(1.025);
  }

  .selected-projects__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1rem;
  }

  .selected-projects__meta {
    margin-bottom: 0.35rem;
    color: var(--muted, #6b7280);
    font-size: 0.86rem;
  }

  .selected-projects__body h3 {
    margin-bottom: 0.45rem;
  }

  .selected-projects__body h3 a {
    color: inherit;
    text-decoration: none;
  }

  .selected-projects__body h3 a:hover,
  .selected-projects__body h3 a:focus-visible {
    color: var(--accent-dark, #1d4ed8);
  }

  .selected-projects__keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .selected-projects__keywords span {
    border: 1px solid var(--line, #e5e7eb);
    border-radius: 999px;
    color: var(--muted, #6b7280);
    padding: 0.18rem 0.5rem;
    font-size: 0.82rem;
  }

  @media (max-width: 720px) {
    .selected-projects__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
