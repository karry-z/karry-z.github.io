---
type Props = {
  src: string;
  title: string;
  fallback: string;
};

const { src, title, fallback } = Astro.props;
---

<section class="section section--compact">
  <div class="pdf-preview">
    <object data={src} type="application/pdf" width="100%" height="900" aria-label={title}>
      <p>{fallback} <a href={src} download>{title}</a></p>
    </object>
  </div>
</section>
